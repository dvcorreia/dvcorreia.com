---
import Mascot from "./Mascot.astro";

const links = [
	{ href: "/posts", label: "Posts" },
	{ href: "/now", label: "Now" },
];

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
	pathname === href || pathname.startsWith(`${href}/`);
const isHome = pathname === "/";
---

<a
	href="/"
	class:list={[{ active: isHome }]}
	aria-current={isHome ? "page" : undefined}
>
	<Mascot width="3rem" />
</a>

<nav>
	<ul>
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						class:list={[{ active: isCurrent(link.href) }]}
						aria-current={isCurrent(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style is:global>
	@layer components {
		/* Width + inline offset come from the page frame rule (base layer). */
		body > header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-block: 2.5rem;

			& nav ul {
				padding: 0;
			}
			& nav li {
				display: inline-block;
				margin-inline-end: 2rem;

				&:last-child {
					margin-inline-end: 0;
				}
			}
			& nav a:link {
				text-decoration: none;
			}
		}
	}
</style>
